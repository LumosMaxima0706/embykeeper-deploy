{
  "type": "object",
  "additionalProperties": false,
  "required": ["last_success", "next_run", "last_error", "enabled_profiles_count", "failed_profiles_count"],
  "properties": {
    "last_success": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "next_run": {"type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "last_error": {"type": "string", "pattern": "^[A-Z0-9_.:-]*$"},
    "enabled_profiles_count": {"type": "integer", "minimum": 0},
    "failed_profiles_count": {"type": "integer", "minimum": 0}
  }
}
